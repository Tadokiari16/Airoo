# Valores de `supabase start` (Supabase local). En producción salen del proyecto de Supabase.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Solo en el servidor: crea invitaciones y administra cuentas.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
# Conexión directa a Postgres (Drizzle).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# Dirección pública del panel; se usa en las ligas de invitación y recuperación.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Llave para cifrar los números de cuenta (32 bytes en base64). Esta es solo
# para local; en producción se genera otra: openssl rand -base64 32
LLAVE_CIFRADO=buVrGvbIVD0z1uEEjkrx4LKGOY9BNviUrtiFBut3g0E=
# Dónde se guardan las fotos de catálogo: «local» (carpeta .almacen, para
# probar sin Supabase Storage) o «supabase» (bucket público «fotos»).
ALMACEN_FOTOS=local
